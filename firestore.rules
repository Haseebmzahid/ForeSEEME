rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // riskEstimates (ADR-001 / docs/RISK_SCHEMA.md):
    // Authenticated clients may READ; clients may NEVER write. The collection is
    // written only by the backend service account, whose Admin SDK bypasses
    // these rules. NOTE: Firestore ORs `allow` rules across matching blocks, so
    // the recursive wildcard below also matches this path — `write: if false`
    // only guarantees denial while that wildcard does not itself allow writes.
    match /riskEstimates/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 6, 1);
    }
  }
}
