rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function hasActiveSession() {
      return request.auth != null && sessionAfterRevocation(request.auth.uid);
    }

    function sessionAfterRevocation(uid) {
      let cutoff = /databases/$(database)/documents/sessionRevocations/$(uid);
      return !exists(cutoff) || request.auth.token.get('auth_time', 0)
        > get(cutoff).data.throughAuthTime;
    }

    // A role grant and an interactive, verified second factor are both required.
    function isAdmin() {
      return hasActiveSession()
        && request.auth.token.get('admin', false) == true
        && request.auth.token.get('firebase', {}).get('sign_in_second_factor', '') in ['phone', 'totp'];
    }

    // riskEstimates (ADR-001 / docs/RISK_SCHEMA.md) — Sprint 3 risk binding:
    // Any AUTHENTICATED client may READ; clients may NEVER write. The collection
    // is written only by the backend service account, whose Admin SDK bypasses
    // these rules. This rule is self-sufficient: `read: if hasActiveSession()`
    // denies unauthenticated reads on its own. With the production default-deny
    // catch-all below (`if false`), `write: if false` is now absolute — no other
    // matching block grants writes to this path (Firestore ORs `allow` rules, and
    // `false` contributes nothing).
    match /riskEstimates/{docId} {
      allow read: if hasActiveSession();
      allow write: if false;
    }

    function owns(userId) {
      return hasActiveSession() && request.auth.uid == userId;
    }

    function validPreferences(prefs) {
      return prefs is map
        && prefs.keys().hasOnly([
          'highRiskAlerts', 'mediumRiskAlerts', 'lowRiskUpdates', 'conditions', 'schemaVersion'
        ])
        && prefs.get('highRiskAlerts', true) is bool
        && prefs.get('mediumRiskAlerts', true) is bool
        && prefs.get('lowRiskUpdates', false) is bool
        && prefs.get('schemaVersion', 1) == 1
        && prefs.get('conditions', {}) is map
        && prefs.get('conditions', {}).keys().hasOnly(['respiratory', 'cardiovascular'])
        && prefs.get('conditions', {}).get('respiratory', true) is bool
        && prefs.get('conditions', {}).get('cardiovascular', false) is bool;
    }

    function validUserSettings(data, changed) {
      return changed.hasOnly(['fcmToken', 'fcmTokenUpdatedAt', 'notificationPreferences'])
        && (!changed.hasAny(['notificationPreferences'])
          || validPreferences(data.get('notificationPreferences', {})))
        && (!changed.hasAny(['fcmToken'])
          || (data.get('fcmToken', '') is string && data.get('fcmToken', '').size() <= 4096))
        && (!changed.hasAny(['fcmTokenUpdatedAt'])
          || data.get('fcmTokenUpdatedAt', request.time) is timestamp);
    }

    match /users/{userId} {
      allow get, delete: if owns(userId);
      allow create: if owns(userId)
        && validUserSettings(request.resource.data, request.resource.data.keys());
      allow update: if owns(userId) && validUserSettings(
        request.resource.data, request.resource.data.diff(resource.data).affectedKeys()
      );

      match /profile/{profileId} {
        function profileFields() {
          return ['uid', 'city', 'chronicConditions', 'lastUpdated'];
        }
        function validProfile(data) {
          return profileId == userId
            && data.get('uid', userId) == userId
            && data.city in ['Lahore', 'Islamabad', 'Karachi', 'Rawalpindi', 'Peshawar']
            && data.chronicConditions is list
            && data.chronicConditions.size() <= 5
            && data.chronicConditions.hasOnly([
              'Asthma', 'Diabetes', 'Hypertension', 'Heart Disease', 'None'
            ])
            && data.lastUpdated == request.time;
        }
        allow read, delete: if owns(userId);
        allow create: if owns(userId) && validProfile(request.resource.data)
          && request.resource.data.keys().hasOnly(profileFields());
        allow update: if owns(userId) && validProfile(request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileFields());
      }

      match /medications/{id} {
        allow read, delete: if owns(userId);
        allow create: if owns(userId) && request.resource.data.keys().hasOnly([
          'id', 'uid', 'name', 'dosage', 'type', 'frequency', 'reminderTimes', 'isActive', 'createdAt'
        ]);
        allow update: if owns(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'id', 'uid', 'name', 'dosage', 'type', 'frequency', 'reminderTimes', 'isActive', 'createdAt'
          ]);
      }

      match /{subcollection}/{id} {
        // Retain owner access to both current and legacy adherence records.
        function adherencePath() {
          return subcollection in ['adherence_logs', 'adherenceLogs'];
        }
        function adherenceFields() {
          return [
            'medicationId', 'uid', 'scheduledTime', 'date', 'selectedDate',
            'status', 'confirmedAt', 'timestamp', 'taken'
          ];
        }
        allow read, delete: if owns(userId) && adherencePath();
        allow create: if owns(userId) && adherencePath()
          && request.resource.data.keys().hasOnly(adherenceFields());
        allow update: if owns(userId) && adherencePath()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(adherenceFields());
      }
    }

    // Account-bound, server-timestamped acceptance with no client edits.
    // Allow each released version here before shipping a client that requires it.
    match /medicalDisclaimerAcceptances/{uid}/versions/{version} {
      allow get: if hasActiveSession() && request.auth.uid == uid;
      allow create: if hasActiveSession() && request.auth.uid == uid
        && version == 'v1'
        && request.resource.data.keys().hasOnly(['version', 'acceptedAt'])
        && request.resource.data.version == version
        && request.resource.data.acceptedAt == request.time;
    }

    // The dispatch ledger contains per-user data. Clients read aggregates only.
    match /alertDispatchLog/{logId} {
      allow read: if false;
      allow write: if false;
    }

    // userAlerts/{uid}/... (Sprint 4 P1): the in-app inbox. The dispatch engine
    // creates entries via the Admin SDK (bypasses rules). The owner may READ
    // their own alerts and MARK them read (update `read`/`readAt` only) — never
    // create, delete, or edit content; and never another user's alerts.
    match /userAlerts/{userId}/{document=**} {
      allow read: if hasActiveSession() && request.auth.uid == userId;
      allow create, delete: if false;
      // Owner may only flip `read`/`readAt` on an existing alert. Implemented
      // WITHOUT MapDiff (no `diff()/affectedKeys()`), using only keys()/hasOnly/
      // get()/== — the most broadly supported rules primitives — to remove the
      // MapDiff emulator-compatibility question entirely. Security is identical:
      //   1. the write may contain no key outside the frozen alert schema, so no
      //      arbitrary field can be smuggled in; and
      //   2. every content field must equal its stored value, so `read`/`readAt`
      //      are the only fields that can change (changing OR removing any content
      //      field makes its value differ and denies).
      // Frozen schema: backend `dispatch_alerts._alert_body` / `UserAlertModel`.
      // `resource != null` keeps the get()s safe if ever reached without an
      // existing document.
      allow update: if hasActiveSession()
                    && request.auth.uid == userId
                    && resource != null
                    && request.resource.data.keys().hasOnly([
                         'title', 'body', 'category', 'city', 'riskLevel',
                         'disease', 'recommendation', 'deepLink', 'riskEstimateId',
                         'createdAt', 'read', 'readAt'
                       ])
                    && request.resource.data.get('title', null)
                         == resource.data.get('title', null)
                    && request.resource.data.get('body', null)
                         == resource.data.get('body', null)
                    && request.resource.data.get('category', null)
                         == resource.data.get('category', null)
                    && request.resource.data.get('city', null)
                         == resource.data.get('city', null)
                    && request.resource.data.get('riskLevel', null)
                         == resource.data.get('riskLevel', null)
                    && request.resource.data.get('disease', null)
                         == resource.data.get('disease', null)
                    && request.resource.data.get('recommendation', null)
                         == resource.data.get('recommendation', null)
                    && request.resource.data.get('deepLink', null)
                         == resource.data.get('deepLink', null)
                    && request.resource.data.get('riskEstimateId', null)
                         == resource.data.get('riskEstimateId', null)
                    && request.resource.data.get('createdAt', null)
                         == resource.data.get('createdAt', null);
    }

    // Public-to-authenticated risk projection. The audited admin API writes it.
    match /overrides/{city} {
      allow read: if hasActiveSession();
      allow write: if false;
    }

    // Published resources. The audited admin API owns publication.
    match /articles/{articleId} {
      allow read: if hasActiveSession();
      allow write: if false;
    }

    // Owners may supply bounded onboarding metadata. Auth state is service-owned.
    match /userDirectory/{uid} {
      allow read: if isAdmin();
      allow create: if hasActiveSession() && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/adminAccountOperations/$(uid))
        && request.resource.data.get('email', '') in ['', request.auth.token.get('email', '')]
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt', 'status'])
        && validDirectoryEntry(request.resource.data);
      allow update: if hasActiveSession() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'email', 'createdAt', 'status'])
        && resource.data.get('authDisabled', false) == false
        && (request.resource.data.get('email', '') == resource.data.get('email', '')
          || request.resource.data.get('email', '') in ['', request.auth.token.get('email', '')])
        && validDirectoryEntry(request.resource.data);
      allow delete: if false;
    }

    // Directory self-service must not introduce arbitrary or sensitive fields.
    function validDirectoryEntry(data) {
      return data.get('status', '') in ['active', 'pending']
        && data.get('name', '') is string && data.get('name', '').size() <= 160
        && data.get('createdAt', '') is string && data.get('createdAt', '').size() <= 40
        && data.get('email', '') is string && data.get('email', '').size() <= 320;
    }

    match /operationalMetrics/{metric} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminActivityLog/{entryId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    // jobHeartbeats/{job} (Sprint 5 P12): operator observability heartbeats,
    // written only by the backend service account (Admin SDK bypasses rules) —
    // no client may ever write here. Sprint M8.1 adds the same narrow admin-read
    // exception as `alertDispatchLog` above, so the System Monitoring Dashboard
    // (SDS FR8.1, "model version" / "last run time" / job health) can read them.
    // A non-admin still has zero access, matching the pre-M8.1 behaviour exactly;
    // the user-facing complement remains the in-app staleness indicator (Prompt 11).
    match /jobHeartbeats/{job} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // PRODUCTION DEFAULT-DENY (replaces the expired temporary dev catch-all,
    // `request.time < timestamp.date(2026, 6, 1)`). Firestore denies by default,
    // and this makes that intent explicit and permanent: any path NOT matched by
    // an allow-rule above is fully denied to all clients. It never weakens the
    // rules above — Firestore ORs `allow` rules across matching blocks, and
    // `if false` grants nothing, so every explicit grant above still applies.
    // Every collection the app/back-end uses is covered above:
    //   • riskEstimates            — authed read, no client write
    //   • users/{uid}[/**]         — owner-only (profile, medications,
    //                                adherence_logs subtrees included)
    //   • userAlerts/{uid}/**      — owner read + scoped mark-read only
    //   • alertDispatchLog         — admin-claim read (M8.1), else service-account
    //                                only (Admin SDK bypass)
    //   • overrides/{city}         — authed read, admin-claim write
    //   • jobHeartbeats/{job}      — admin-claim read (M8.1), else service-account
    //                                only (Admin SDK bypass)
    //   • adminActivityLog/{id}    — admin-claim create + read, immutable (M8.2)
    //   • articles/{articleId}     — authed read, admin-claim write (M8.3)
    //   • userDirectory/{uid}      — owner write, admin-claim read (M8.4)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
