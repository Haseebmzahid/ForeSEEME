rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Shared admin-claim check (Sprint 5 P13 introduced the pattern for
    // `overrides`; Sprint M8.1 reuses it for the read-only monitoring grants
    // below instead of re-deriving it inline each time). `.get('admin', false)`
    // rather than `request.auth.token.admin`: a non-admin's token has no `admin`
    // key, and dot-access on a missing key raises "Property admin is undefined";
    // `.get` returns the default and denies cleanly instead.
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    // riskEstimates (ADR-001 / docs/RISK_SCHEMA.md) — Sprint 3 risk binding:
    // Any AUTHENTICATED client may READ; clients may NEVER write. The collection
    // is written only by the backend service account, whose Admin SDK bypasses
    // these rules. This rule is self-sufficient: `read: if request.auth != null`
    // denies unauthenticated reads on its own. With the production default-deny
    // catch-all below (`if false`), `write: if false` is now absolute — no other
    // matching block grants writes to this path (Firestore ORs `allow` rules, and
    // `false` contributes nothing).
    match /riskEstimates/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // users/{uid} (Sprint 3 P7/P8): a signed-in user may read and write ONLY
    // their own document and subtree — this is where `fcmToken` and
    // `notificationPreferences` live (and the health-profile subcollection).
    // A user can never read or write another user's token/data (uid must match).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      match /{document=**} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // alertDispatchLog (Sprint 4 P1): ops audit + throttle/idempotency ledger.
    // Written ONLY by the service account (Admin SDK bypasses rules) — no client
    // may ever write here. Sprint M8.1 adds one deliberate, narrow exception to
    // "service-only": an admin may READ, so the System Monitoring Dashboard
    // (SDS FR8.1, "alerts count") can total dispatch attempts. This is a genuine,
    // considered widening of the admin claim's scope (previously `overrides` was
    // the only collection admin got extra rights on) — a non-admin still has no
    // access at all, matching the pre-M8.1 behaviour exactly.
    match /alertDispatchLog/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // userAlerts/{uid}/... (Sprint 4 P1): the in-app inbox. The dispatch engine
    // creates entries via the Admin SDK (bypasses rules). The owner may READ
    // their own alerts and MARK them read (update `read`/`readAt` only) — never
    // create, delete, or edit content; and never another user's alerts.
    match /userAlerts/{userId}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, delete: if false;
      // Owner may only flip `read`/`readAt` on an existing alert. Implemented
      // WITHOUT MapDiff (no `diff()/affectedKeys()`), using only keys()/hasOnly/
      // get()/== — the most broadly supported rules primitives — to remove the
      // MapDiff emulator-compatibility question entirely. Security is identical:
      //   1. the write may contain no key outside the frozen alert schema, so no
      //      arbitrary field can be smuggled in; and
      //   2. every content field must equal its stored value, so `read`/`readAt`
      //      are the only fields that can change (changing OR removing any content
      //      field makes its value differ and denies).
      // Frozen schema: backend `dispatch_alerts._alert_body` / `UserAlertModel`.
      // `resource != null` keeps the get()s safe if ever reached without an
      // existing document.
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && resource != null
                    && request.resource.data.keys().hasOnly([
                         'title', 'body', 'category', 'city', 'riskLevel',
                         'disease', 'recommendation', 'deepLink', 'riskEstimateId',
                         'createdAt', 'read', 'readAt'
                       ])
                    && request.resource.data.get('title', null)
                         == resource.data.get('title', null)
                    && request.resource.data.get('body', null)
                         == resource.data.get('body', null)
                    && request.resource.data.get('category', null)
                         == resource.data.get('category', null)
                    && request.resource.data.get('city', null)
                         == resource.data.get('city', null)
                    && request.resource.data.get('riskLevel', null)
                         == resource.data.get('riskLevel', null)
                    && request.resource.data.get('disease', null)
                         == resource.data.get('disease', null)
                    && request.resource.data.get('recommendation', null)
                         == resource.data.get('recommendation', null)
                    && request.resource.data.get('deepLink', null)
                         == resource.data.get('deepLink', null)
                    && request.resource.data.get('riskEstimateId', null)
                         == resource.data.get('riskEstimateId', null)
                    && request.resource.data.get('createdAt', null)
                         == resource.data.get('createdAt', null);
    }

    // overrides/{city} (Sprint 5 P13): the manual risk-override safety valve.
    // Any AUTHENTICATED client may READ (so every risk surface can honestly
    // indicate an active override); only an OPERATOR — a user carrying the
    // `admin` custom claim (granted server-side via backend/scripts/set_admin_claim.py,
    // so it cannot be forged) — may WRITE. Audit fields (author/reason/timestamp)
    // live on the document. A normal user is denied all writes here.
    match /overrides/{city} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // articles/{articleId} (Sprint M8.3): the Health Resource Center's CMS
    // content (SDS FR8.3). Any AUTHENTICATED client may READ — the same
    // openness as `riskEstimates`, since every user reads the same published
    // library; only an admin may WRITE (create or edit an article). There is
    // no draft/review state (SDS's "if workflow enabled" is not enabled for
    // v1): a write is immediately visible to every reader.
    match /articles/{articleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // adminActivityLog/{entryId} (Sprint M8.2): append-only audit trail of
    // admin actions (SDS FR8.4) — currently risk-override set/clear, written
    // by the same authorised client that performs the action (same trust
    // model as `overrides`: the admin claim is the gate; audit fields are
    // client-asserted, not independently verified). Immutable once written —
    // no update or delete, even by an admin — so the trail cannot be edited
    // after the fact.
    match /adminActivityLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // jobHeartbeats/{job} (Sprint 5 P12): operator observability heartbeats,
    // written only by the backend service account (Admin SDK bypasses rules) —
    // no client may ever write here. Sprint M8.1 adds the same narrow admin-read
    // exception as `alertDispatchLog` above, so the System Monitoring Dashboard
    // (SDS FR8.1, "model version" / "last run time" / job health) can read them.
    // A non-admin still has zero access, matching the pre-M8.1 behaviour exactly;
    // the user-facing complement remains the in-app staleness indicator (Prompt 11).
    match /jobHeartbeats/{job} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // PRODUCTION DEFAULT-DENY (replaces the expired temporary dev catch-all,
    // `request.time < timestamp.date(2026, 6, 1)`). Firestore denies by default,
    // and this makes that intent explicit and permanent: any path NOT matched by
    // an allow-rule above is fully denied to all clients. It never weakens the
    // rules above — Firestore ORs `allow` rules across matching blocks, and
    // `if false` grants nothing, so every explicit grant above still applies.
    // Every collection the app/back-end uses is covered above:
    //   • riskEstimates            — authed read, no client write
    //   • users/{uid}[/**]         — owner-only (profile, medications,
    //                                adherence_logs subtrees included)
    //   • userAlerts/{uid}/**      — owner read + scoped mark-read only
    //   • alertDispatchLog         — admin-claim read (M8.1), else service-account
    //                                only (Admin SDK bypass)
    //   • overrides/{city}         — authed read, admin-claim write
    //   • jobHeartbeats/{job}      — admin-claim read (M8.1), else service-account
    //                                only (Admin SDK bypass)
    //   • adminActivityLog/{id}    — admin-claim create + read, immutable (M8.2)
    //   • articles/{articleId}     — authed read, admin-claim write (M8.3)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
