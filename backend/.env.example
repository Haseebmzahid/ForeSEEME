# ForeSeeMe risk service — example environment configuration.
# Copy to `.env` (git-ignored) and adjust as needed. Contains NO secrets;
# all values here are safe, non-secret defaults.

# Version string stamped onto responses and reported by GET /health.
# The placeholder stub model reports "stub-0.0.0".
MODEL_VERSION=stub-0.0.0

# Root log level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# Port uvicorn binds inside the container (consumed by the Docker CMD).
PORT=8000

# Optional explicit path to the promoted model artifact. When unset, the service
# discovers the latest backend/ml/artifacts/model_<version>.joblib.
# MODEL_ARTIFACT_PATH=/app/ml/artifacts/model_1.0.0.joblib

# --- Scheduled risk-compute job (Prompt 15) ---------------------------------
# Trailing window of recent weeks fetched per city for lag/rolling features.
RISK_LOOKBACK_WEEKS=12

# Firestore auth for the batch job — set EXACTLY ONE path (secrets via env only,
# never committed; the service-account JSON is git-ignored):
#   Real project:  GOOGLE_APPLICATION_CREDENTIALS=/secure/path/foreseeme-sa.json
#   Emulator:      FIRESTORE_EMULATOR_HOST=localhost:8080  (+ FIREBASE_PROJECT_ID)
# GOOGLE_APPLICATION_CREDENTIALS=
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_PROJECT_ID=demo-foreseeme
