# ForeSeeMe backend job deployment — shared config (Phase 1: compute_risk only)
#
# Copy to config.env (git-ignored) and adjust, or export these as shell vars
# before running provision_compute_risk.sh / verify_compute_risk.sh.
# Contains NO secrets — project id, region, and naming only.

PROJECT_ID=foreseeme-83587
REGION=us-central1

# Artifact Registry
AR_REPO=backend
IMAGE_TAG=phase1-compute-risk
IMAGE="${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}/foreseeme-backend:${IMAGE_TAG}"

# Service accounts (shared across future jobs; only compute_risk's role is
# granted in Phase 1 — dispatch_alerts/weekly_report add roles/firebasemessaging.admin
# in Phase 2, not before).
SA_JOBS_ID=risk-jobs-sa
SA_JOBS="${SA_JOBS_ID}@${PROJECT_ID}.iam.gserviceaccount.com"

SA_SCHEDULER_ID=scheduler-invoker-sa
SA_SCHEDULER="${SA_SCHEDULER_ID}@${PROJECT_ID}.iam.gserviceaccount.com"

# Cloud Run Job (compute_risk only)
JOB_NAME=compute-risk-job
JOB_TIMEOUT=600s        # 10 min
JOB_MEMORY=512Mi
JOB_CPU=1
RISK_LOOKBACK_WEEKS=12
LOG_LEVEL=INFO

# Cloud Scheduler (compute_risk only)
SCHEDULER_NAME=compute-risk-weekly
SCHEDULE="0 0 * * 1"    # Monday 00:00 UTC
TIME_ZONE=UTC
