# ForeSeeMe backend job deployment — shared config (Phase 2: compute_risk +
# dispatch_alerts. weekly_report is not provisioned yet.)
#
# Copy to config.env (git-ignored) and adjust, or export these as shell vars
# before running provision_<job>.sh / verify_<job>.sh. Contains NO secrets —
# project id, region, and naming only.

PROJECT_ID=foreseeme-83587
REGION=us-central1

# Artifact Registry — ONE image shared by every job (ADR-002: "one deployable
# artifact"); only each Cloud Run Job's command override differs.
AR_REPO=backend
IMAGE_TAG=latest        # override with a git short-sha for a traceable deploy
IMAGE="${REGION}-docker.pkg.dev/${PROJECT_ID}/${AR_REPO}/foreseeme-backend:${IMAGE_TAG}"

# Service accounts — shared across all three jobs (single trust boundary, no
# multi-tenant separation to enforce; see backend/deploy/README.md).
SA_JOBS_ID=risk-jobs-sa
SA_JOBS="${SA_JOBS_ID}@${PROJECT_ID}.iam.gserviceaccount.com"

SA_SCHEDULER_ID=scheduler-invoker-sa
SA_SCHEDULER="${SA_SCHEDULER_ID}@${PROJECT_ID}.iam.gserviceaccount.com"

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# compute_risk
# ---------------------------------------------------------------------------
# Phase 2 architectural decision: DAILY, not weekly. The model is already
# trained; a daily run only performs inference over fresh weather/AQI data,
# which is cheap. No code change needed — app/jobs/compute_risk.py already
# names each scheduled document by the run's calendar date (`document_id()`),
# not by ISO week, so invoking it daily naturally produces one fresh
# `riskEstimates` doc per city per day out of the box.
COMPUTE_RISK_JOB_NAME=compute-risk-job
COMPUTE_RISK_SCHEDULER_NAME=compute-risk-daily
COMPUTE_RISK_SCHEDULE="0 0 * * *"     # daily 00:00 UTC
COMPUTE_RISK_TIME_ZONE=UTC
COMPUTE_RISK_TIMEOUT=600s             # 10 min
COMPUTE_RISK_MEMORY=512Mi
COMPUTE_RISK_CPU=1
RISK_LOOKBACK_WEEKS=12

# ---------------------------------------------------------------------------
# dispatch_alerts
# ---------------------------------------------------------------------------
# Daily, offset 10 minutes after compute_risk so it always evaluates that
# day's fresh riskEstimates (soft ordering by schedule offset, not a hard
# dependency — see the Phase-1/2 architecture discussion: a miss is benign,
# not corrupting, because zero-sends grades `ok`, and idempotency prevents
# any double-send regardless of timing).
DISPATCH_ALERTS_JOB_NAME=dispatch-alerts-job
DISPATCH_ALERTS_SCHEDULER_NAME=dispatch-alerts-daily
DISPATCH_ALERTS_SCHEDULE="10 0 * * *" # daily 00:10 UTC
DISPATCH_ALERTS_TIME_ZONE=UTC
DISPATCH_ALERTS_TIMEOUT=300s          # 5 min
DISPATCH_ALERTS_MEMORY=512Mi
DISPATCH_ALERTS_CPU=1
